# =============================================================================
# .env.example — copy to .env and fill in. NEVER commit .env.
#
#   cp .env.example .env
#
# Every value here is a placeholder. If you see a real-looking token in this
# file on a public repo, it has been leaked and must be rotated immediately.
# =============================================================================

# -----------------------------------------------------------------------------
# Slack — Socket Mode for local development
#
# Where to find these (api.slack.com/apps -> your app):
#   SLACK_BOT_TOKEN   OAuth & Permissions -> Bot User OAuth Token (xoxb-)
#   SLACK_APP_TOKEN   Basic Information -> App-Level Tokens, scope connections:write (xapp-)
#   SLACK_SIGNING_SECRET  Basic Information -> App Credentials
#
# Bot token scopes needed for Phase 0 + 1:
#   channels:history, channels:read, chat:write, groups:history, groups:read,
#   reactions:write, users:read
# Event subscriptions: message.channels, message.groups
# -----------------------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-REPLACE-ME
SLACK_APP_TOKEN=xapp-REPLACE-ME
SLACK_SIGNING_SECRET=REPLACE-ME

# -----------------------------------------------------------------------------
# Anthropic
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME

# Tiered routing models. Cheap handles routine traffic; deep handles ambiguous
# or high-stakes messages. Model IDs must exist in triage.model_pricing or the
# composite FK on llm_invocations will reject the write.
TRIAGE_CHEAP_MODEL=claude-haiku-4-5-20251001
TRIAGE_DEEP_MODEL=claude-sonnet-5

# Escalate a cheap-tier result to the deep tier when the model reports
# confidence below this, or when it assigns urgency at or above the threshold
# (a cheap model calling something a P1 deserves a second opinion).
TRIAGE_ESCALATE_BELOW_CONFIDENCE=0.75
TRIAGE_ESCALATE_AT_URGENCY=4

# -----------------------------------------------------------------------------
# PostgreSQL
#
# Matches docker-compose.yml defaults for local dev. On Fly.io this is injected
# as a secret and will point at the internal .flycast address.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://triage:triage_local_dev@localhost:5433/triage
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_COMMAND_TIMEOUT_SECONDS=10

# -----------------------------------------------------------------------------
# Privacy
#
# Master key for deriving per-workspace HMAC keys used to fingerprint message
# content. NOT a hash salt you can publish — treat it like a signing key.
#
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Rotating this invalidates all existing fingerprints (dedup breaks, nothing
# else does). content_hmac_key_id on each workspace records which generation
# produced its fingerprints.
# -----------------------------------------------------------------------------
CONTENT_HMAC_MASTER_KEY=REPLACE-ME-GENERATE-A-RANDOM-48-BYTE-KEY
CONTENT_HMAC_KEY_GENERATION=v1

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# Pretty console logs locally, single-line JSON in production. Structured
# logging is on in both cases; this only changes the renderer.
LOG_RENDERER=console

# Version stamps written onto every classification row. Bump PROMPT_VERSION
# whenever you edit a prompt, or your eval comparisons become meaningless.
PROMPT_VERSION=v1
TAXONOMY_VERSION=v1
PIPELINE_VERSION=v1
