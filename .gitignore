# =============================================================================
# SECRETS — the entries that actually matter for a public repo.
# These come first and are deliberately broad. It is far cheaper to
# force-add a file you meant to commit than to rotate a leaked token.
# =============================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json
service-account*.json
.ngrok*
fly.toml.local

# Slack tokens sometimes get pasted into scratch files. Block the usual names.
scratch.*
notes.local.*
TODO.local.*

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.installed.cfg
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / coverage / type-check caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# =============================================================================
# Database and local infrastructure
# =============================================================================
pgdata/
*.dump
*.sql.gz
docker-compose.override.yml

# =============================================================================
# Logs — structured JSON logs can contain message content. Never commit them.
# =============================================================================
*.log
logs/

# =============================================================================
# Editors / OS
# =============================================================================
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*.swo
.DS_Store
Thumbs.db
